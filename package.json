{
  "name": "extreme-wikilinks",
  "version": "0.4.0",
  "description": "Take your Wikilinks to the eXtreme! By applying templates to change their appearance. EXTREME!",
  "main": "main.js",
  "files": [
    "main.js",
    "core.mjs",
    "types/",
    "manifest.json",
    "styles.css"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "prepare": "npm run build",
    "lint": "eslint .",
    "check:core": "npm run types && node scripts/check-core.mjs",
    "readme": "node scripts/generate-readme.mjs",
    "check:readme": "node scripts/generate-readme.mjs --check",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "obsidian-review": "node ../obsidian-plugin-review/dist/cli.js run --repo . --type plugin",
    "review": "npm run lint && npm run typecheck && npm run build && npm run obsidian-review",
    "clean:types": "node -e \"require('fs').rmSync('types',{recursive:true,force:true})\"",
    "types": "npm run clean:types && tsc --noEmit false --emitDeclarationOnly --declaration --rootDir src --outDir types"
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "obsidian-debug-logger": "git+https://github.com/bobstanton/obsidian-debug-logger.git",
    "placeholder-resolver": "git+https://github.com/bobstanton/placeholder-resolver.git#7450cfe6e37b09d73b66bf955fc0ddc143095e82"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@lezer/common": "^1.5.2",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "require": "./main.js",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./core.mjs",
      "default": "./core.mjs"
    }
  }
}
